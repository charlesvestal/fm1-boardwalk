# Balloons: a round played by the test player (a key held, let go on the ring): every balloon tied and perfect, a
# best kept. Let go at four fifths of the ring: tied, fewer points, the best stays. Held on and on: it pops. A key
# held by the script on level 3 pops too; one let go at once leaves the balloon on the nozzle. Tickets for each round
# played out (a few for a poor one), none for one stopped with PLAY
wait 800
turn SELECT 2
wait 400
expect cab 3
tap PLAY
wait 100
expect game 4
expect balloon_state 0
expect keys_mid 875136
shot stand.png
autoballoon on
tap PLAY
wait 250
expect balloon_state 1
expect balloon_phase 0
shot wait.png
wait 1350
expect balloon_phase 1
shot pump.png
wait 1600
shot tied.png
wait 700
shot float.png
wait 57300
expect balloon_state 2
expect balloon_tied 10
expect balloon_popped 0
expect balloon_perfect 10
expect balloon_score 100
expect balloon_best 100
expect won 33
shot over.png
autoballoon early
tap PLAY
wait 600
expect balloon_state 1
wait 60000
expect balloon_state 2
expect balloon_tied 10
expect balloon_perfect 0
expect balloon_score <100
expect balloon_best 100
expect won 38
autoballoon over
tap PLAY
wait 600
expect balloon_state 1
wait 2500
shot pumpover.png
wait 2000
expect balloon_popped 1
expect balloon_score 0
shot pop.png
autoballoon off
tap PLAY
wait 100
expect balloon_state 0
expect won 38
turn K1 2
wait 50
expect balloon_level 3
shot stand3.png
turn K1 -1
wait 50
expect balloon_level 2
shot stand2.png
turn K1 1
wait 50
expect balloon_level 3
tap PLAY
wait 700
key 9 down
wait 150
key 9 up
wait 100
expect balloon_phase 0
key 12 down
wait 5000
expect balloon_popped 1
key 12 up
wait 100
tap PLAY
wait 100
expect balloon_state 0
expect won 38
