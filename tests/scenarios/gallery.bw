# The shooting gallery: every duck shot midway: twenty of twenty; mashing every key on the by-ear level scores little
wait 800
turn SELECT 5
wait 400
expect cab 6
tap PLAY
wait 100
shot stand.png
autoshoot on
tap PLAY
wait 6000
shot playing.png
wait 60000
expect gallery_state 2
expect gallery_score 20
# twenty of twenty on level 1: 20 + 400 / 20 tickets
expect won 40
shot over.png
autoshoot off
turn K1 3
wait 50
mash on
tap PLAY
wait 70000
expect gallery_state 2
expect gallery_score <8
# mashing: the pity tickets
expect won 42
mash off
# a round stopped with PLAY pays nothing
autoshoot on
tap PLAY
wait 8000
expect gallery_state 1
tap PLAY
wait 3000
expect gallery_state 0
expect won 42
expect pay 0
autoshoot off
