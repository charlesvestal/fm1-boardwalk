# The boardwalk: the cabinets, walking along them, each one's attract tune, the sea and tunes knobs, stepping into
# a cabinet and back; the save across a reboot
wait 800
expect game 0
expect cab 1
expect tune_cab 1
shot boardwalk.png
tap OCT+
wait 100
expect cab 2
expect tune_cab -1
wait 400
expect tune_cab 2
shot moles.png
tap PLAY
wait 200
expect game 3
shot moles_stand.png
tap HOME
wait 200
expect game 0
tap OCT+
wait 400
expect cab 3
shot balloons.png
tap OCT+
wait 400
expect cab 4
shot tiles.png
turn SELECT -3
wait 400
expect cab 1
turn K1 -4
wait 50
expect surf 20
shot sea.png
tap PLAY
wait 200
expect game 2
expect tune_cab -1
shot striker.png
tap HOME
wait 2000
reboot
wait 800
expect cab 1
expect surf 20
